# Environment for `pocket-tts serve` / `generate` (copy to .env or export).
# Command-line options take precedence over these variables.

# GGUF model file (from `pocket-tts convert`); unset to use POCKET_TTS_VARIANT
POCKET_TTS_MODEL=models/french-q8_0.gguf
# Built-in variant when no GGUF is given: english, french, french_24l, ...
POCKET_TTS_VARIANT=french
# cpu, cuda, cuda:1, metal
POCKET_TTS_DEVICE=cpu
# CPU threads (1-4 is best at batch 1)
POCKET_TTS_THREADS=4
# Server
POCKET_TTS_HOST=127.0.0.1
POCKET_TTS_PORT=8000
POCKET_TTS_VOICE=estelle
# Hugging Face token for the gated voice-cloning weights (or run `hf auth login`)
# HF_TOKEN=hf_...
# Log level
RUST_LOG=info
